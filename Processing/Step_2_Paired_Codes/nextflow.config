workDir = './work'

params {
    // This one is generated in Reference/pair_all_codes.py
    icd10_pair_code_file = '../../Reference/all_observed_pair.txt'
    cohort_code = 'default_cohort'
    final_df_file = ''

    // Remove pairs where observed count is less than 10
    min_both_count = 10

    // How many code pair to process at the same time 
    batch_size = 100

}